<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="smartphone_doctor_db" />
        <exclude domain="database" path="smartphone_doctor_db-wal" />
        <exclude domain="database" path="smartphone_doctor_db-shm" />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.debug.store.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.debug.store.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store.xml" />
    </device-transfer>
</data-extraction-rules>
